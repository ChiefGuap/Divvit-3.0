# Supabase — divvit-dashboard project (cmzxfwqixqcuyitsilal, us-east-2).
# The marketplace tables are the mp_* ones. NOT the "Divvit" consumer project.
NEXT_PUBLIC_SUPABASE_URL=https://cmzxfwqixqcuyitsilal.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Where each site lives. In production: https://divvit.app and https://marketplace.divvit.app
NEXT_PUBLIC_SITE_URL=http://localhost:3200
NEXT_PUBLIC_MARKETPLACE_URL=http://marketplace.localhost:3200

# Optional: People Data Labs key for funding/HQ autofill (free tier available).
# Without it, autofill uses the YC directory + the startup's own website.
PDL_API_KEY=

# café website verification; the same value goes in mp_private.settings (key verify_secret)
DIVVIT_VERIFY_SECRET=

# Payments: startups pay for an approved campaign through Stripe Checkout (lib/server/stripe.ts).
# Test keys (sk_test_…) until launch. The webhook secret comes from
#   stripe listen --forward-to localhost:3200/api/stripe/webhook
# locally, or from the dashboard's webhook endpoint (checkout.session.completed +
# checkout.session.async_payment_succeeded → https://marketplace.divvit.app/api/stripe/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "on" adds sales tax with Stripe Tax (set up Tax in the Stripe dashboard first)
STRIPE_TAX=

# Campaign emails (lib/server/notify.ts) through Resend
RESEND_API_KEY=
DIVVIT_TEAM_EMAIL=elliott@divvit.app,raquib@divvit.app
DIVVIT_FROM_EMAIL="Divvit <elliott@divvit.app>"

# Optional: Claude picks the suggested neighborhoods (otherwise a built-in matcher does)
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
